# Optional shell configuration. After editing: source .env
# All relative paths assume the repository root as current directory.
export GMR_ROOT="$PWD/vendor/gmr"
export GMR_PY="$GMR_ROOT/.venv/bin/python"
export SMPLX_BODY_MODELS="$GMR_ROOT/assets/body_models"
export G1_XML="$PWD/assets/mjlab_unitree_g1/xmls/g1.xml"
# Required only when rerunning the external GVHMR stage:
# export GVHMR_ROOT=/path/to/GVHMR
# export GVHMR_PY=/path/to/gvhmr/environment/bin/python
export V2M_WORK="$PWD/work/video2motion"
export MUJOCO_GL=egl
